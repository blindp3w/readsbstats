[Unit]
Description=readsbstats weekly DB quick_check
OnFailure=notify-telegram@%n.service

# Wait for the data directory's mount when it is a separate one (e.g. an fstab
# `nofail` USB disk). No-op when the directory lives on the root filesystem.
RequiresMountsFor=@DATA_DIR@

[Service]
Type=oneshot
User=readsbstats
Group=readsbstats
# Rendered by install.sh/update.sh. Keeps the app's default DB paths aligned
# with the ReadWritePaths= sandbox below.
Environment=RSBS_DATA_DIR=@DATA_DIR@
ExecStart=/opt/readsbstats/venv/bin/python /opt/readsbstats/scripts/check_db.py --mode quick
WorkingDirectory=/opt/readsbstats
# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=@DATA_DIR@
# quick_check is read-only but reads every page off the (USB) disk while the
# collector writes; a read-only WAL reader also walks the -wal frames, so wall
# time scales with DB + WAL size and disk contention, not CPU. Measured ~60 s
# standalone on a 1.2 GB DB with a 119 MB WAL, and >120 s during a deploy/reboot
# I/O storm. 120 s was too tight (false 'timeout' failures + Telegram alerts);
# 600 s was enough until it was not: on 2026-10-25 a run timed out at 600 s
# with 57 s CPU (IO-bound), and a cold-cache check of a 1.8 GB DB took 197 s
# with no contention at all. 1800 s.
TimeoutStartSec=1800

# Audit-13 A13-046: kernel + namespace hardening.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

StandardOutput=journal
StandardError=journal
SyslogIdentifier=readsbstats-dbcheck
