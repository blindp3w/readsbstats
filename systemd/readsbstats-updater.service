[Unit]
Description=readsbstats aircraft/airline database updater
After=network-online.target
Wants=network-online.target

# Wait for the data directory's mount when it is a separate one (e.g. an fstab
# `nofail` USB disk). No-op when the directory lives on the root filesystem.
RequiresMountsFor=@DATA_DIR@

[Service]
Type=oneshot
User=readsbstats
Group=readsbstats
# Rendered by install.sh/update.sh. Keeps the app's default DB paths aligned
# with the ReadWritePaths= sandbox below.
Environment=RSBS_DATA_DIR=@DATA_DIR@
# v2.12.2: stop the collector before the updater body runs and restart it
# after, so the weekly timer path can't collide with concurrent writers on
# the v2.11.7+ single-transaction aircraft_db swap. `+` runs as root,
# bypassing User=/hardening for these systemctl calls only — User=
# readsbstats cannot manage system units without polkit. ExecStopPost
# always runs, so a crashed/timed-out updater still restores the collector.
# Skip the run (not a failure; next Monday catches up) while the collector is
# still starting, e.g. in its post-crash quick_check: stopping it there throws
# the check away. grep exits 1 when the only line is ActiveState=activating.
# Not `After=readsbstats-collector.service`: systemd orders our stop job before
# the collector's start job, so ExecStopPost's `systemctl start` would deadlock.
ExecCondition=+/bin/sh -c 'systemctl show -p ActiveState readsbstats-collector.service | grep -qvx ActiveState=activating'
ExecStartPre=+/bin/systemctl stop readsbstats-collector.service
ExecStart=/opt/readsbstats/venv/bin/python -m readsbstats.db_updater
# --no-block: ExecStopPost also runs after an ExecCondition skip, when the
# collector's own start job may take minutes; just enqueue the start.
ExecStopPost=+/bin/systemctl --no-block start readsbstats-collector.service
WorkingDirectory=/opt/readsbstats
# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=@DATA_DIR@
# v2.12.2: 300 → 900 — the v2.11.7+ single-transaction swap holds
# BEGIN IMMEDIATE for the full CREATE + chunked INSERT + rename sequence;
# on Pi-4 SD/USB that's 3–5 min for 620 k rows. 900 s gives ~3× headroom.
TimeoutStartSec=900

# Audit-13 A13-046: kernel + namespace hardening.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

StandardOutput=journal
StandardError=journal
SyslogIdentifier=readsbstats-updater
