[Unit]
Description=readsbstats ADS-B History Collector
After=network.target readsb.service
Wants=readsb.service
OnFailure=notify-telegram@%n.service
StartLimitIntervalSec=120
StartLimitBurst=5

# Wait for the data directory's mount when it is a separate one (e.g. an fstab
# `nofail` USB disk). No-op when the directory lives on the root filesystem.
RequiresMountsFor=@DATA_DIR@

[Service]
Type=notify
WatchdogSec=60
User=readsbstats
Group=readsbstats
# Rendered by install.sh/update.sh. Keeps the app's default DB paths aligned
# with the ReadWritePaths= sandbox below.
Environment=RSBS_DATA_DIR=@DATA_DIR@
WorkingDirectory=/opt/readsbstats
ExecStart=/opt/readsbstats/venv/bin/python -m readsbstats.collector
Restart=on-failure
RestartSec=10

# Single settings file shared by all readsbstats units (RSBS_* overrides,
# Telegram token, ...). Optional (`-`): absent => built-in defaults. Read by
# systemd as root before privileges drop. See systemd/readsbstats.env.example.
EnvironmentFile=-/etc/readsbstats/readsbstats.env
TimeoutStartSec=300

# Be polite to the Pi — readsb/tar1090 are the primary tenants.
# MemoryMax counts page cache too, and the collector connection's mmap_size is
# 256 MB (see database.connect). After an unclean shutdown the startup
# PRAGMA quick_check streams the whole DB through it: measured ~3 min on a
# 1.8 GB DB from a cold USB HDD, and at the old 15% / 192M caps it thrashed and
# never finished inside the start timeout. Nice=10 + IOSchedulingPriority=7
# already keep readsb ahead of this service.
CPUQuota=50%
MemoryMax=1G
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=@DATA_DIR@
ReadOnlyPaths=/run/readsb

# Audit-13 A13-046: kernel + namespace hardening. Targets systemd-analyze
# security score < 5. MemoryDenyWriteExecute is not set yet: it has not
# been verified on the Pi against CPython and the loaded C extensions.
# Check with `systemd-analyze security readsbstats-collector.service` and
# add `MemoryDenyWriteExecute=yes` once verified safe.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

# Logging goes to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=readsbstats-collector

[Install]
WantedBy=multi-user.target
