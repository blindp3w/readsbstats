[Unit]
Description=readsbstats VDL2 / ACARS ingest listener
# Opt-in feature. NOT enabled by install.sh — enable explicitly with
#   sudo systemctl enable --now readsbstats-vdl2.service
# Consume-only: an external decoder (dumpvdl2 recommended and the code default;
# vdlm2dec is legacy — set RSBS_VDL2_DECODER=vdlm2dec to match it) feeds
# line-delimited JSON over UDP to RSBS_VDL2_UDP_HOST:PORT. This service writes a
# SEPARATE vdl2.db; it never touches history.db. See docs/operations.md for the
# decoder runbook.
After=network.target
OnFailure=notify-telegram@%n.service
StartLimitIntervalSec=120
StartLimitBurst=5

# Wait for the data directory's mount when it is a separate one (e.g. an fstab
# `nofail` USB disk). No-op when the directory lives on the root filesystem.
RequiresMountsFor=@DATA_DIR@

[Service]
Type=notify
WatchdogSec=60
User=readsbstats
Group=readsbstats
# Rendered by install.sh/update.sh. Keeps the app's default DB paths aligned
# with the ReadWritePaths= sandbox below. This unit reads only vdl2.env (not
# readsbstats.env), so it needs the variable here.
Environment=RSBS_DATA_DIR=@DATA_DIR@
WorkingDirectory=/opt/readsbstats
ExecStart=/opt/readsbstats/venv/bin/python -m readsbstats.vdl2_collector
Restart=on-failure
RestartSec=10
TimeoutStartSec=120

# Single source of truth for the VDL2 flag + tunables, shared with
# readsbstats-web so one file gates both surfaces (the `-` makes it optional —
# no failure if absent). Set RSBS_VDL2_ENABLED=true there, then
# `systemctl enable --now readsbstats-vdl2`. When the flag is false this unit
# starts, sends READY, and exits cleanly (dormant — see vdl2_collector.main).
EnvironmentFile=-/etc/readsbstats/vdl2.env

# Be polite to the Pi — readsb/tar1090 and the core collector come first.
# MemoryMax counts page cache too. After an unclean shutdown the startup
# PRAGMA quick_check streams the whole vdl2.db through it (the core DB took
# ~3 min for 1.8 GB from a cold USB HDD); at the old 10% / 256M caps the check
# thrashed and never finished inside the start timeout. Nice=10 +
# IOSchedulingPriority=7 already keep readsb ahead of this service.
CPUQuota=50%
MemoryMax=768M
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# Security hardening (mirrors readsbstats-collector.service)
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=@DATA_DIR@
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# AF_INET/AF_INET6 needed for the UDP listener; AF_UNIX for sd_notify
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

# Logging goes to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=readsbstats-vdl2

[Install]
WantedBy=multi-user.target
