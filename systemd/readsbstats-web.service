[Unit]
Description=readsbstats ADS-B History Web Server
After=network.target readsbstats-collector.service
StartLimitIntervalSec=120
StartLimitBurst=5

# Wait for the data directory's mount when it is a separate one (e.g. an fstab
# `nofail` USB disk). No-op when the directory lives on the root filesystem.
RequiresMountsFor=@DATA_DIR@

[Service]
Type=simple
User=readsbstats
Group=readsbstats
# Rendered by install.sh/update.sh. Keeps the app's default DB paths aligned
# with the ReadWritePaths= sandbox below.
Environment=RSBS_DATA_DIR=@DATA_DIR@
WorkingDirectory=/opt/readsbstats
ExecStart=/opt/readsbstats/venv/bin/uvicorn readsbstats.web:app \
    --host 127.0.0.1 \
    --port 8080 \
    --workers 1 \
    --root-path /stats \
    --log-level warning
Restart=on-failure
RestartSec=5

# Single settings file shared by all readsbstats units (RSBS_* overrides,
# Telegram token, ...). Optional (`-`): absent => built-in defaults. Read by
# systemd as root before privileges drop. See systemd/readsbstats.env.example.
EnvironmentFile=-/etc/readsbstats/readsbstats.env

# Shared opt-in VDL2 flag (one file gates web surfaces + the ingest service).
# Optional (`-`): absent ⇒ feature off. See systemd/readsbstats-vdl2.env.example.
EnvironmentFile=-/etc/readsbstats/vdl2.env

CPUQuota=50%
# Bumped from 384M → 1024M on 2026-05-16: the /api/map/heatmap endpoint
# scans + GROUPs over millions of positions on a busy receiver, and the
# in-memory sort/hash for the aggregate easily exceeds 384M during the
# first uncached request — OOM-killing the worker. Pi 4 has 8GB and a
# steady-state utilisation around 1.7GB, so 1GB for this service is well
# within budget and leaves room for occasional 30d/all-window peaks.
MemoryMax=1024M
Nice=10

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=@DATA_DIR@

# Audit-13 A13-046: kernel + namespace hardening. See collector unit
# comments (MemoryDenyWriteExecute: not yet verified on the Pi).
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

StandardOutput=journal
StandardError=journal
SyslogIdentifier=readsbstats-web

[Install]
WantedBy=multi-user.target
