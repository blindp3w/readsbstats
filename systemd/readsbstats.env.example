# readsbstats settings -- the single settings file, read by
# readsbstats-collector, readsbstats-web and notify-telegram@ (via
# EnvironmentFile=/etc/readsbstats/readsbstats.env).
#
# Install: scripts/install.sh creates /etc/readsbstats/readsbstats.env from this
# example on a fresh install. Keep it mode 0600, owner root:root -- it holds the
# Telegram bot token (systemd reads it as root, before dropping privileges).
#
# Values here override a unit's Environment= lines. Exception: the VDL2/ACARS
# settings belong in /etc/readsbstats/vdl2.env — the web unit loads
# that file after this one, so a RSBS_VDL2_ENABLED set here would be overridden.
# Restart the services after editing:
#   sudo systemctl restart readsbstats-collector readsbstats-web
#
# Everything below is optional; uncomment and edit what you need. Defaults are
# shown. Keep comments on their own lines: systemd does not strip trailing
# comments from a value. Full list: docs/configuration.md

# Receiver location -- SET THESE (defaults are a Warsaw-area example)
# RSBS_LAT=52.24199
# RSBS_LON=21.02872

# Days to keep raw positions rows (0 = keep forever; 180 suits a Pi-class install)
# RSBS_RETENTION_DAYS=0

# CARTO basemap API key (map shows placeholder tiles without one)
# RSBS_CARTO_API_KEY=

# Telegram notifications (disabled while the token is empty)
# RSBS_TELEGRAM_TOKEN=
# RSBS_TELEGRAM_CHAT_ID=
# Daily summary time, local HH:MM ("off" disables it)
# RSBS_SUMMARY_TIME=21:00
# metric | imperial | aeronautical
# RSBS_TELEGRAM_UNITS=metric
# Base URL for links in messages -- set to your Pi's URL
# RSBS_TELEGRAM_BASE_URL=http://homepi.local/stats

# MCP server (opt-in, see docs/mcp.md). Read by readsbstats-mcp only.
# Bind address and port (loopback by default)
# RSBS_MCP_HOST=127.0.0.1
# RSBS_MCP_PORT=8765
# Extra accepted Host headers (host:port), comma-separated, for non-loopback binds
# RSBS_MCP_ALLOWED_HOSTS=
# Per-client token file (name, scopes, sha256), root:readsbstats 0640
# RSBS_MCP_TOKENS_FILE=/etc/readsbstats/mcp-tokens
# Web API the server calls (loopback http only)
# RSBS_MCP_API_URL=http://127.0.0.1:8080
# Per-client limits: read calls per minute, watchlist writes and photo fetches per hour
# RSBS_MCP_READ_PER_MIN=30
# RSBS_MCP_WRITE_PER_HOUR=10
# RSBS_MCP_PHOTO_PER_HOUR=20
# Concurrent API calls across all clients, and watchlist size cap for MCP additions
# RSBS_MCP_CONCURRENCY=2
# RSBS_MCP_WATCHLIST_MAX=100
