# NOTE: gitignore has NO inline comments — keep each pattern on its own line.

# Python
__pycache__/
*.py[cod]
venv/
.venv/
*.egg-info/
*.egg
/build/
/dist/
.mypy_cache/
.ruff_cache/
.tox/
.hypothesis/

# Local data — the whole db/ folder is local-only (DB copies from the Pi,
# exports, analysis output); nothing in it may ever reach GitHub, whatever
# the file extension.
/db/
# DB files anywhere else (incl. journals, backups like history.db.backup.*,
# compressed copies like history.db.zst)
*.db
*.db-wal
*.db-shm
*.db-journal
*.db.*
*.sqlite
*.sqlite3
*.sqlite-*

# OS
.DS_Store
._*
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Test / coverage
.coverage
.coverage.*
coverage.xml
.pytest_cache/
htmlcov/
tests/ui/screenshots/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Secrets / local config (tracked templates are *.env.example)
.env
.env.*
*.env
*.env.local
!*.env.example
*.pem
*.key

# Frontend (Vite + npm) — dist/ is rsync'd to the Pi but never committed
node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
frontend/.eslintcache
# TypeScript incremental-build caches; one per tsconfig.*.json
*.tsbuildinfo

# Playwright (HTML report + intermediate per-run artefacts)
playwright-report/
test-results/

# Internal / private project material (not for public repo)
internal_docs/

# Session continuity (internal, not for public repo)
NOTES.md
scratchpad.md

# AI assistant / agent context — ALL local-only, never public.
# Hard internal/public split: agent context + internal_docs/ stay off GitHub;
# only docs/ (incl. docs/decisions ADRs) and code are public.
# Claude Code dir (settings.local.json, commands, hooks):
.claude/
# CLAUDE.md at any depth + CLAUDE.local.md / CLAUDE.old.md / future variants:
CLAUDE*.md
.clauderc
# Other agent tools (Codex, Gemini, Cursor, Windsurf, Cline, Roo, Continue,
# Kiro, Junie, Aider, Serena MCP, SpecStory, Copilot):
AGENTS.md
GEMINI.md
.agents/
.codex/
.gemini/
.cursor/
.cursorrules
.windsurf/
.windsurfrules
.clinerules
.roo/
.continue/
.kiro/
.junie/
.aider*
.serena/
.specstory/
# Copilot only — do NOT ignore all of .github/ (workflows are public):
.github/copilot-instructions.md
.github/instructions/
.github/prompts/
# MCP server configs may embed tokens / private endpoints:
.mcp.json
mcp.json

# Playwright MCP output (screenshots / console / snapshots)
.playwright-mcp/

# superpowers brainstorming companion artifacts
.superpowers/

# superpowers process artifacts (specs/plans) — distilled into docs/decisions
# when architecturally significant; the raw workflow docs stay local-only.
docs/superpowers/
